---
/**
 * PostRow —— 首页 / 文章页「一行一篇」的列表项
 * 结构仿照 thedissidents.net：图文左右分栏，标题衬线大字，
 * 作者靠左、日期靠右，下方一行摘要，底部虚线分隔。
 */
import { formatDate, getSlug, excerpt, readingTime, type Post } from '../lib/utils';

interface Props {
  post: Post;
  /** 序号，可选（显示在左侧） */
  index?: number;
  /** 紧凑模式：无封面时也保持单行高度 */
  compact?: boolean;
  /** 是否显示首字母大图（featured） */
  featured?: boolean;
}

const { post, index, featured = false } = Astro.props;
const { data } = post;
const slug = getSlug(post);
const href = `/articles/${slug}`;
const cover = data.cover;
const hasCover = Boolean(cover);
const summary = excerpt(post, 96);
const rt = data.readingTime ?? readingTime(post.body);
---

<article class="group relative py-7 md:py-9">
  <a href={href} class="absolute inset-0 z-10" aria-label={data.title}></a>

  <div
    class:list={[
      'flex gap-5 md:gap-8',
      hasCover ? 'items-start' : 'items-start',
    ]}
  >
    <!-- 左侧文字 -->
    <div class="min-w-0 flex-1">
      <!-- 元信息行：日期 / 时长 -->
      <div class="flex items-center gap-3 mb-2">
        {
          index !== undefined && (
            <span class="meta tabular-nums opacity-60">
              {String(index).padStart(2, '0')}
            </span>
          )
        }
        <time datetime={data.pubDate.toISOString()} class="meta">
          {formatDate(data.pubDate)}
        </time>
        {data.pinned && (
          <span class="font-sans text-[0.62rem] tracking-[0.14em] uppercase text-accent border border-accent/40 px-1.5 py-0.5">
            置顶
          </span>
        )}
      </div>

      <!-- 标题 -->
      <h2
        class:list={[
          'font-serif font-semibold leading-[1.35] text-ink tracking-[0.01em]',
          'transition-colors duration-200 group-hover:text-accent',
          featured ? 'text-[1.6rem] md:text-[2.1rem]' : 'text-[1.15rem] md:text-[1.32rem]',
        ]}
      >
        {data.title}
      </h2>

      {
        data.subtitle && (
          <p class="mt-1.5 font-serif text-[0.95rem] md:text-[1rem] text-ink-soft leading-relaxed">
            {data.subtitle}
          </p>
        )
      }

      {
        summary && (
          <p
            class:list={[
              'mt-2.5 text-[0.86rem] md:text-[0.9rem] leading-[1.8] text-ink-soft',
              'line-clamp-2 md:line-clamp-2',
              featured ? 'max-w-2xl' : 'max-w-xl',
            ]}
          >
            {summary}
          </p>
        )
      }

      <!-- 作者 + 标签 + 阅读时长 -->
      <div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="meta">{data.author}</span>
        <span class="w-px h-3 bg-rule"></span>
        <span class="meta">{rt} 分钟</span>
        {
          data.tags.length > 0 && (
            <span class="flex flex-wrap gap-1.5 relative z-20">
              {data.tags.slice(0, 3).map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-chip">
                  {tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </div>

    <!-- 右侧封面 -->
    {
      hasCover && (
        <div
          class:list={[
            'shrink-0 overflow-hidden bg-paper-soft',
            featured
              ? 'w-32 h-24 md:w-72 md:h-48'
              : 'w-24 h-20 md:w-44 md:h-32',
          ]}
        >
          <div class="w-full h-full transition-transform duration-700 ease-out group-hover:scale-[1.04]">
            <img
              src={cover}
              alt={data.coverAlt || data.title}
              loading="lazy"
              decoding="async"
              width={featured ? 720 : 440}
              height={featured ? 480 : 320}
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      )
    }
  </div>
</article>

<style>
  /* 列表分隔线：最后一项不画 */
  article:has(+ article) {
    border-bottom: 1px dashed var(--color-rule);
  }
  article:last-of-type {
    border-bottom: none;
  }
</style>
