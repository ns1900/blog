---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这里什么都没有。" noindex>
  <section class="wrap min-h-[60vh] flex items-center">
    <div class="max-w-md">
      <p class="font-sans text-[0.68rem] tracking-[0.26em] uppercase text-ink-faint">
        404
      </p>
      <h1 class="mt-3 font-serif text-[1.8rem] md:text-[2.2rem] font-semibold text-ink">
        这条路走到头了
      </h1>
      <p class="mt-4 font-serif text-[0.95rem] leading-relaxed text-ink-soft">
        页面可能已经被移动、改名，或者从未存在过。
      </p>
      <div class="mt-8 flex gap-5">
        <a href="/" class="font-sans text-[0.82rem] text-ink border-b border-ink pb-0.5 hover:text-accent hover:border-accent transition-colors">
          回首页
        </a>
        <a href="/articles" class="font-sans text-[0.82rem] text-ink-soft border-b border-rule pb-0.5 hover:text-accent hover:border-accent transition-colors">
          看文章
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
